{
    "name": "@havaem/tailwindcss-havaem",
    "description": "Havaem's TailwindCSS plugin, providing additional utilities and components.",
    "version": "0.1.0",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "files": [
        "src"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/havaem/tailwindcss-havaem.git"
    },
    "keywords": [
        "havaem",
        "tailwindcss-havaem",
        "tailwindcss",
        "tailwind",
        "css",
        "postcss",
        "plugin"
    ],
    "publishConfig": {
        "access": "public"
    },
    "prettier": {
        "printWidth": 120,
        "semi": false,
        "singleQuote": true,
        "trailingComma": "all",
        "endOfLine": "auto",
        "tabWidth": 4
    },
    "peerDependencies": {
        "tailwindcss": ">=4.1.0"
    },
    "devDependencies": {
        "tailwindcss": "^4.1.0"
    }
}
